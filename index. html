<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BAO — Premium Asian Street Food</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Noto+Sans+SC:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #0d0d0f;
      --card-bg: #16161a;
      --accent-gold: #d4af37;
      --accent-gold-hover: #f1c40f;
      --text-main: #f5f5f7;
      --text-sub: #8e8e93;
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      padding-bottom: 110px;
    }

    /* Шапка сайта */
    header {
      padding: 25px 20px 15px;
      text-align: center;
      background: linear-gradient(180deg, rgba(212, 175, 55, 0.12) 0%, rgba(13, 13, 15, 0) 100%);
    }

    .logo {
      font-family: 'Cinzel', serif;
      font-size: 38px;
      font-weight: 700;
      letter-spacing: 8px;
      color: var(--accent-gold);
      text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
    }

    .subtitle {
      font-size: 10px;
      letter-spacing: 3px;
      color: var(--text-sub);
      text-transform: uppercase;
      margin-top: 2px;
    }

    /* Верхние быстрые плитки */
    .hero-categories {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      padding: 0 15px 15px;
      max-width: 500px;
      margin: 0 auto;
    }

    .hero-card {
      position: relative;
      height: 90px;
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform 0.15s ease;
    }

    .hero-card:active {
      transform: scale(0.96);
    }

    .hero-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.6);
    }

    .hero-card span {
      position: absolute;
      bottom: 10px;
      left: 12px;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: 1px;
      color: #fff;
      text-shadow: 0 2px 4px rgba(0,0,0,0.9);
    }

    /* Горизонтальная навигация (Фильтр) */
    .tabs-wrapper {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(13, 13, 15, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .tabs-nav {
      display: flex;
      gap: 8px;
      padding: 12px 15px;
      overflow-x: auto;
      scrollbar-width: none;
      max-width: 500px;
      margin: 0 auto;
    }

    .tabs-nav::-webkit-scrollbar {
      display: none;
    }

    .tab-btn {
      background: var(--card-bg);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: var(--text-sub);
      padding: 8px 16px;
      border-radius: 20px;
      white-space: nowrap;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .tab-btn.active {
      background: var(--accent-gold);
      color: #000;
      border-color: var(--accent-gold);
      font-weight: 700;
      box-shadow: 0 0 12px rgba(212, 175, 55, 0.3);
    }

    /* Контейнер блюд */
    .menu-container {
      max-width: 500px;
      margin: 15px auto 0;
      padding: 0 15px;
    }

    .dish-card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 12px;
      margin-bottom: 12px;
      display: flex;
      gap: 12px;
      border: 1px solid rgba(255, 255, 255, 0.04);
      box-shadow: 0 4px 15px rgba(0,0,0,0.4);
      animation: fadeIn 0.25s ease-in-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .dish-card img {
      width: 95px;
      height: 95px;
      border-radius: 12px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .dish-details {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .dish-title {
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 3px;
    }

    .dish-desc {
      font-size: 11px;
      color: var(--text-sub);
      line-height: 1.35;
      margin-bottom: 8px;
    }

    .dish-action {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .dish-price {
      font-size: 15px;
      font-weight: 700;
      color: var(--accent-gold);
    }

    /* Кнопки плюс/минус и добавить */
    .add-btn {
      background: rgba(212, 175, 55, 0.12);
      border: 1px solid var(--accent-gold);
      color: var(--accent-gold);
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .add-btn:active {
      background: var(--accent-gold);
      color: #000;
    }

    .counter-control {
      display: flex;
      align-items: center;
      gap: 10px;
      background: rgba(255,255,255,0.05);
      padding: 3px 8px;
      border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.1);
    }

    .counter-btn {
      background: none;
      border: none;
      color: var(--accent-gold);
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      width: 20px;
      text-align: center;
    }

    .counter-value {
      font-size: 13px;
      font-weight: 700;
      color: #fff;
    }

    /* Плавающая плашка заказа */
    .cart-float {
      position: fixed;
      bottom: 15px;
      left: 15px;
      right: 15px;
      max-width: 470px;
      margin: 0 auto;
      background: rgba(22, 22, 26, 0.95);
      backdrop-filter: blur(15px);
      border: 1px solid var(--accent-gold);
      border-radius: 16px;
      padding: 12px 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
      z-index: 200;
    }

    .cart-info {
      font-size: 12px;
      color: var(--text-sub);
    }

    .cart-info b {
      color: #fff;
      font-size: 16px;
      display: block;
      margin-top: 1px;
    }

    .order-btn {
      background: var(--accent-gold);
      color: #000;
      border: none;
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .order-btn:active {
      background: var(--accent-gold-hover);
    }
  </style>
</head>
<body>

  <header>
    <div class="logo">BAO</div>
    <div class="subtitle">Asian Noodles & Sushi Bar</div>
  </header>

  <div class="hero-categories">
    <div class="hero-card" onclick="filterCategory('bao')">
      <img src="https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=400&q=80" alt="Бао">
      <span>БАО</span>
    </div>
    <div class="hero-card" onclick="filterCategory('ramen')">
      <img src="https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=400&q=80" alt="Рамены">
      <span>РАМЕНЫ</span>
    </div>
  </div>

  <div class="tabs-wrapper">
    <div class="tabs-nav" id="tabsNav">
      <button class="tab-btn active" onclick="filterCategory('all', this)">Всё меню</button>
      <button class="tab-btn" onclick="filterCategory('bao', this)">Бао</button>
      <button class="tab-btn" onclick="filterCategory('ramen', this)">Супы & Рамены</button>
      <button class="tab-btn" onclick="filterCategory('rolls', this)">Роллы</button>
      <button class="tab-btn" onclick="filterCategory('starters', this)">Закуски</button>
      <button class="tab-btn" onclick="filterCategory('drinks', this)">Напитки</button>
    </div>
  </div>

  <div class="menu-container" id="menuList"></div>

  <div class="cart-float">
    <div class="cart-info">
      Итого заказ:
      <b id="cartTotal">0 ₸</b>
    </div>
    <button class="order-btn" onclick="checkout()">Оформить заказ</button>
  </div>

  <script>
    // Данные меню ресторана BAO
    const dishes = [
      // БАО
      { id: 1, category: 'bao', name: 'Бао с хрустящей курицей', desc: 'Паровая булочка бао, хрустящее куриное филе, соус спайси и свежие огурцы.', price: 2490, img: 'https://images.unsplash.com/photo-1563245372-f21724e3856d?auto=format&fit=crop&w=300&q=80' },
      { id: 2, category: 'bao', name: 'Бао с рваной говядиной', desc: 'Азиатская булочка, томлёная говядина в соусе хойсин, кинза и лук фри.', price: 2790, img: 'https://images.unsplash.com/photo-1625220194771-7ebdea0b70b9?auto=format&fit=crop&w=300&q=80' },
      
      // СУПЫ И РАМЕНЫ
      { id: 3, category: 'ramen', name: 'Том Ям с креветкой', desc: 'Острый тайский суп на кокосовом молоке с тигровыми креветками и грибами цаогу.', price: 3890, img: 'https://images.unsplash.com/photo-1547592166-23ac45744acd?auto=format&fit=crop&w=300&q=80' },
      { id: 4, category: 'ramen', name: 'Тонкоцу Рамен', desc: 'Насыщенный свиной бульон, пшеничная лапша, маринованное яйцо и чашу.', price: 3490, img: 'https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=300&q=80' },
      
      // РОЛЛЫ
      { id: 5, category: 'rolls', name: 'Филадельфия с лососем', desc: 'Свежий лосось, сливочный сыр, огурец, авокадо и рис нишики.', price: 3990, img: 'https://images.unsplash.com/photo-1611143669185-af224c5e3252?auto=format&fit=crop&w=300&q=80' },
      { id: 6, category: 'rolls', name: 'Запечённый Крач Ролл', desc: 'Снежный краб, икра тобико, соус унаги, спайси замес и хрустящий кляр.', price: 3290, img: 'https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&w=300&q=80' },
      
      // ЗАКУСКИ
      { id: 7, category: 'starters', name: 'Гёдза с креветкой', desc: 'Японские обжаренные пельмени с начинкой из тигровых креветок и зелени.', price: 2890, img: 'https://images.unsplash.com/photo-1496116218417-1a781b1c416c?auto=format&fit=crop&w=300&q=80' },
      { id: 8, category: 'starters', name: 'Битые огурцы', desc: 'Огурцы в пикантном соусе с чесноком, кинзой, кунжутным маслом и арахисом.', price: 1890, img: 'https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&w=300&q=80' },

      // НАПИТКИ
      { id: 9, category: 'drinks', name: 'Лимонад Манго-Маракуйя', desc: 'Освежающий авторский лимонад с натуральным пюре манго и мятой.', price: 1690, img: 'https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?auto=format&fit=crop&w=300&q=80' }
    ];

    // Состояние корзины
    let cart = {};

    // Отрисовка блюд
    function renderMenu(categoryFilter = 'all') {
      const container = document.getElementById('menuList');
      container.innerHTML = '';

      const filtered = categoryFilter === 'all' 
        ? dishes 
        : dishes.filter(item => item.category === categoryFilter);

      filtered.forEach(dish => {
        const count = cart[dish.id] || 0;
        const card = document.createElement('div');
        card.className = 'dish-card';

        let buttonHTML = count === 0
          ? `<button class="add-btn" onclick="updateCart(${dish.id}, 1)">+ В корзину</button>`
          : `<div class="counter-control">
               <button class="counter-btn" onclick="updateCart(${dish.id}, -1)">-</button>
               <span class="counter-value">${count}</span>
               <button class="counter-btn" onclick="updateCart(${dish.id}, 1)">+</button>
             </div>`;

        card.innerHTML = `
          <img src="${dish.img}" alt="${dish.name}">
          <div class="dish-details">
            <div>
              <div class="dish-title">${dish.name}</div>
              <div class="dish-desc">${dish.desc}</div>
            </div>
            <div class="dish-action">
              <span class="dish-price">${dish.price.toLocaleString()} ₸</span>
              ${buttonHTML}
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    // Фильтрация по категориям
    function filterCategory(cat, element) {
      if(element) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
      } else {
        // Если кликнули по верхней плитке — подсвечиваем нужную кнопку в меню
        document.querySelectorAll('.tab-btn').forEach(btn => {
          btn.classList.toggle('active', btn.getAttribute('onclick').includes(`'${cat}'`));
        });
      }
      renderMenu(cat);
    }

    // Обновление корзины
    function updateCart(id, change) {
      cart[id] = (cart[id] || 0) + change;
      if (cart[id] <= 0) delete cart[id];

      // Перерисовываем активную категорию
      const activeTab = document.querySelector('.tab-btn.active');
      const activeCat = activeTab ? activeTab.getAttribute('onclick').match(/'([^']+)'/)[1] : 'all';
      
      renderMenu(activeCat);
      updateTotal();
    }

    // Расчёт итоговой суммы
    function updateTotal() {
      let total = 0;
      for (let id in cart) {
        let item = dishes.find(d => d.id == id);
        if (item) total += item.price * cart[id];
      }
      document.getElementById('cartTotal').innerText = total.toLocaleString() + ' ₸';
    }

    // Оформление
    function checkout() {
      let totalItems = Object.values(cart).reduce((a, b) => a + b, 0);
      if (totalItems === 0) {
        alert('Корзина пуста! Выберите блюда из меню.');
        return;
      }
      let summary = 'Ваш заказ:\n';
      for (let id in cart) {
        let item = dishes.find(d => d.id == id);
        summary += `• ${item.name} x${cart[id]} = ${(item.price * cart[id]).toLocaleString()} ₸\n`;
      }
      summary += `\nИтого: ${document.getElementById('cartTotal').innerText}`;
      alert(summary);
    }

    // Первый запуск
    renderMenu('all');
  </script>
</body>
</html>
